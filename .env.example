# API server base URL (PVS API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# Supabase (public keys only — never the service role key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Dev-only: fake the hostname that resolve-hostname would match
# In production, this is read from window.location.hostname automatically
NEXT_PUBLIC_DEV_HOSTNAME=dashboard.ifferspictures.com
